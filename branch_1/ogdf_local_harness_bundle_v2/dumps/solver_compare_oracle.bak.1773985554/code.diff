+std::string formatCanonicalExplicitForCompare(const CanonicalExplicitGraph &G) {
+    std::ostringstream oss;
+    oss << "edges[";
+    for (size_t i = 0; i < G.edges.size(); ++i) {
+        if (i != 0) oss << ", ";
+        const auto &[edgeId, u, v] = G.edges[i];
+        oss << '(' << edgeId << ',' << u << ',' << v << ')';
+    }
+    oss << "] vertices[";
+    for (size_t i = 0; i < G.vertices.size(); ++i) {
+        if (i != 0) oss << ", ";
+        oss << G.vertices[i];
+    }
+    oss << ']';
+    return oss.str();
+}
