+    if (classifyExplicitOracleInput(G) == ExplicitOracleInputSubtype::EOI_EMPTY) {
+        return buildCanonicalEmptyOracleCore(core, why);
+    }
+    return buildWholeCoreForSequenceTesting(G, core, why);
+}
