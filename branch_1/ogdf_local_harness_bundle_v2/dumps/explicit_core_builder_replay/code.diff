+    out.actualInvariantWhy = invariantWhy;
+    out.stepOk = invariantOk;
+    out.debugTag = invariantOk ? "REWRITE_SEQ_STEP:STEP_OK"
+                               : "REWRITE_SEQ_STEP:ACTUAL_INVARIANT_FAIL";
+    why = invariantOk ? std::string{} : invariantWhy;
+    return invariantOk;
+}
